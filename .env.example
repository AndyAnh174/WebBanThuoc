# ==============================================
# Environment Variables for WebBanThuoc
# Copy this file to .env and update values
# Used by both Docker Compose and NestJS Server
# ==============================================

# ----------------------
# App Configuration
# ----------------------
NODE_ENV=development
PORT=3000

# ----------------------
# PostgreSQL 16
# ----------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=webbanthuoc

# Connection URL for ORMs (TypeORM, Prisma, etc.)
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# ----------------------
# Redis 7
# ----------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# Connection URL for Redis clients
REDIS_URL=redis://:${REDIS_PASSWORD}@${REDIS_HOST}:${REDIS_PORT}

# ----------------------
# Elasticsearch
# ----------------------
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://${ELASTICSEARCH_HOST}:${ELASTICSEARCH_PORT}

# ----------------------
# MinIO S3 Self-hosted
# ----------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# S3-compatible settings for AWS SDK
AWS_S3_ENDPOINT=http://${MINIO_ENDPOINT}:${MINIO_PORT}
AWS_ACCESS_KEY_ID=${MINIO_ROOT_USER}
AWS_SECRET_ACCESS_KEY=${MINIO_ROOT_PASSWORD}
AWS_S3_BUCKET=webbanthuoc-bucket
AWS_REGION=us-east-1

# ----------------------
# JWT & Security
# ----------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ----------------------
# CORS
# ----------------------
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
