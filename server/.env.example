# ==============================================
# Environment Variables for WebBanThuoc
# Copy this file to .env and update values
# ==============================================

# ----------------------
# App Configuration
# ----------------------
NODE_ENV=development
PORT=3000

# ----------------------
# PostgreSQL 16
# ----------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=admin
POSTGRES_PASSWORD=admin123
POSTGRES_DB=webbanthuoc

# Connection URL for Prisma
DATABASE_URL=postgresql://admin:admin123@localhost:5432/webbanthuoc

# ----------------------
# Redis 7
# ----------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=redis123

# Connection URL for Redis clients
REDIS_URL=redis://:redis123@localhost:6379

# ----------------------
# Elasticsearch
# ----------------------
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_URL=http://localhost:9200

# ----------------------
# MinIO S3 Self-hosted
# ----------------------
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123

# S3-compatible settings for AWS SDK
AWS_S3_ENDPOINT=http://localhost:9000
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_S3_BUCKET=webbanthuoc-bucket
AWS_REGION=us-east-1

# ----------------------
# JWT & Security
# ----------------------
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=7d

# ----------------------
# CORS
# ----------------------
CORS_ORIGINS=http://localhost:3001,http://localhost:3000
